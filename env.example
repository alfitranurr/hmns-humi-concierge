N8N_HOST=localhost
POSTGRES_USER=humi_admin
POSTGRES_PASSWORD=humi_admin
DISCORD_BOT_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here
N8N_WEBHOOK_URL=http://n8n:5678/webhook/humi-discord-in
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
# Google OAuth client for the n8n Google Sheets credential (containers do not read these)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
# Discord relay: where HUMI answers and the welcome message for new members
HUMI_CHANNEL_NAME=tanya-humi
ADMIN_CHANNEL_NAME=admin-hmns
# true only after "Server Members Intent" is enabled in the Discord Developer Portal
ENABLE_WELCOME=false
WELCOME_CHANNEL_NAME=welcome
# Groq API key for the n8n "Groq account" credential (containers do not read it)
GROQ_API_KEY=your_groq_api_key_here
