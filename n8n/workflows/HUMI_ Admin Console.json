      "parameters": {
        "jsCode": "// Build the admin reply for !stock\nconst requested = $('Parse Command').first().json.args[0];\nconst db = $('Update Stock in Postgres').first().json;\n\nif (!db.sku) {\n  return [{ json: { stock_reply: `⚠️ SKU \\`${requested}\\` tidak ada di tabel products. Saat ini yang bisa diupdate adalah SKU parfum \\`HMNS-PRF-001\\` s/d \\`HMNS-PRF-028\\`.` } }];\n}\n\nreturn [{ json: { ...db, stock_reply: `✅ Stok **${db.name}** (${db.sku}) diupdate jadi **${db.web_stock}** di database dan Google Sheet.\\n🔄 HUMI sedang menyinkronkan katalog, notifikasi muncul di sini begitu jawaban ke customer sudah pakai data baru (±1 menit).` } }];"
      },
