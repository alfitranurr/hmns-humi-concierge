    {
      "parameters": {
        "jsCode": "// Format hasil query log jadi teks rapi\nconst row = $json;\nconst total_chat = row.total_chat || 0;\nconst total_user = row.total_user || 0;\nreturn [{ json: { ...row, log_text: `📊 **Log Chat Keseluruhan**\\n\\nTotal pesan tersimpan: ${total_chat}\\nTotal user unik: ${total_user}\\n\\n_Catatan: tabel memori saat ini tidak menyimpan timestamp, sehingga statistik ini mencakup seluruh riwayat, bukan hanya hari ini. Breakdown top pertanyaan & eskalasi akan ditambahkan di versi berikutnya._` } }];"
      },
      "id": "fe350fd6-d853-4f34-815f-a39dc2bbc3fc",
      "name": "Susun Pesan Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fallback: command tidak dikenali\nreturn [{ json: { ...$json, fallback_text: `❓ Command \\`${$json.command || '(kosong)'}\\` tidak dikenali.\\n\\nCommand yang tersedia:\\n\\`!stock <SKU> <jumlah>\\`\\n\\`!harga <SKU> <nominal>\\`\\n\\`!broadcast <teks>\\`\\n\\`!status\\`\\n\\`!log\\`` } }];"
      },
