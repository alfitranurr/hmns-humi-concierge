      "parameters": {
        "jsCode": "// Format hasil update stok jadi teks balasan\nconst row = $json;\n\n// Cek pakai SKU kapital (dari Google Sheets) atau sku kecil (dari Postgres)\nconst sku = row.SKU || row.sku;\nconst nama = row.nama || row.Nama || sku;\nconst stok = row.Stok_Web || row.stok_web;\n\nif (!sku) {\n  return [{ json: { ...row, stock_reply: `⚠️ SKU tidak ditemukan. Pastikan format: \\`!stock HMNS-PRF-001 50\\`` } }];\n}\n\nreturn [{ json: { ...row, stock_reply: `✅ Stok **${nama}** (${sku}) berhasil diupdate jadi **${stok}**.` } }];"
      },
