    {
      "parameters": {
        "jsCode": "// Susun pesan broadcast dari argumen command !broadcast <teks>\nconst args = $json.args || [];\nconst teks = args.join(' ');\n\nif (!teks) {\n  return [{ json: { ...$json, broadcast_text: '⚠️ Format salah. Gunakan: !broadcast <teks pengumuman>' } }];\n}\n\nreturn [{ json: { ...$json, broadcast_text: `📢 **Pengumuman dari HMNS!**\\n\\n${teks}` } }];"
      },
      "id": "709c7290-4a25-40aa-9a1e-d2cb2a8edb35",
      "name": "Susun Pesan Broadcast",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        880
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cek health system: n8n selalu OK kalau workflow ini jalan, jadi fokus cek Postgres & Qdrant\n// Catatan: pengecekan Qdrant/Gemini quota secara langsung butuh HTTP Request node tambahan,\n// di versi awal ini kita laporkan status dasar dulu.\nconst now = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });\nreturn [{ json: { ...$json, status_text: `🩺 **Status Sistem HUMI**\\n\\n✅ n8n: Online\\n✅ Workflow Admin Console: Aktif\\n🕐 Dicek pada: ${now} WIB\\n\\n_Catatan: cek detail Qdrant & kuota Gemini API perlu ditambahkan di versi berikutnya._` } }];"
      },
