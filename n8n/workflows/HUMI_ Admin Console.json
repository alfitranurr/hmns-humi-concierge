    {
      "parameters": {
        "content": "## How it works\nThis workflow runs as a SUB-WORKFLOW of HUMI: Customer Agent, called from the TRUE branch\nof 'IF - Is Admin?' (role HMNS-Admin in #admin-hmns).\n\n!stock and !harga update Postgres and the Google Sheet, then start HUMI: Knowledge Feeder\nso customer answers use the new data. Admin-facing replies are in Indonesian.",
        "height": 280,
        "width": 360
      },
      "id": "e55bb98c-4b02-4332-8eaf-f43ed8aaabee",
      "name": "Note - Architecture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        336,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Split an admin command (!stock, !harga, ...) from its arguments and normalise stock/price\n// arguments so the database and the sheet always use the same format.\nconst body = $input.first().json;\nconst content = (body.content || '').trim();\n\n// Ignore admin messages that are not commands, do not reply\nif (!content.startsWith('!')) {\n  return [];\n}\n\nconst parts = content.split(/\\s+/);\nconst command = parts[0].toLowerCase();\nlet args = parts.slice(1);\nconst SKU_RE = /^HMNS-(PRF|HOH)-\\d{3}$/;\nconst fail = (error_text) => [{ json: { ...body, command: '!error', args, raw_text: content, error_text } }];\n\nif (command === '!stock') {\n  const sku = (args[0] || '').toUpperCase();\n  const raw = args.slice(1).join(' ').trim().toLowerCase();\n  const num = raw.replace(/\\s*pcs$/, '');\n  let stok = null;\n  if (/^(habis|sold\\s?out|kosong)$/.test(raw) || num === '0') stok = 'Sold out';\n  else if (/^\\d+$/.test(num)) stok = `${parseInt(num, 10)} pcs`;\n  if (!SKU_RE.test(sku) || !stok) {\n    return fail('⚠️ Format: `!stock <SKU> <jumlah>`\\nContoh: `!stock HMNS-PRF-001 25` atau `!stock HMNS-PRF-005 habis`');\n  }\n  args = [sku, stok];\n}\n\nif (command === '!harga') {\n  const sku = (args[0] || '').toUpperCase();\n  const raw = (args[1] || '').toLowerCase().replace(/^rp\\.?/, '');\n  let harga = null;\n  const ribu = raw.match(/^(\\d+(?:[.,]\\d+)?)k$/);\n  if (ribu) harga = Math.round(parseFloat(ribu[1].replace(',', '.')) * 1000);\n  else if (/^\\d{1,3}([.,]\\d{3})+$|^\\d+$/.test(raw)) harga = parseInt(raw.replace(/[.,]/g, ''), 10);\n  if (!SKU_RE.test(sku) || !harga) {\n    return fail('⚠️ Format: `!harga <SKU> <nominal>`\\nContoh: `!harga HMNS-PRF-001 350000` atau `!harga HMNS-PRF-001 350k`');\n  }\n  args = [sku, String(harga)];\n}\n\nreturn [{\n  json: {\n    ...body,\n    command,\n    args,\n    raw_text: content\n  }\n}];"
      },
