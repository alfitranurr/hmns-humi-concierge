    {
      "parameters": {
        "jsCode": "// Parsing command admin: pisahkan command (!stock, !harga, dst) dari argumennya\nconst body = $input.first().json;\nconst content = (body.content || '').trim();\n\n// Abaikan pesan non-command dari admin, jangan balas apapun\nif (!content.startsWith('!')) {\n  return [];\n}\n\nconst parts = content.split(/\\s+/);\nconst command = parts[0].toLowerCase();\nconst args = parts.slice(1);\n\nreturn [{\n  json: {\n    ...body,\n    command,\n    args,\n    raw_text: content\n  }\n}];"
      },
