    {
      "parameters": {
        "jsCode": "// Build the admin reply for !harga\nconst requested = $('Parse Command').first().json.args[0];\nconst db = $('Update Price in Postgres').first().json;\n\nif (!db.sku) {\n  return [{ json: { price_reply: `⚠️ SKU \\`${requested}\\` tidak ada di tabel products. Saat ini yang bisa diupdate adalah SKU parfum \\`HMNS-PRF-001\\` s/d \\`HMNS-PRF-028\\`.` } }];\n}\n\nreturn [{ json: { ...db, price_reply: `✅ Harga **${db.name}** (${db.sku}) diupdate jadi **Rp${Number(db.price).toLocaleString('id-ID')}** di database dan Google Sheet.\\n🔄 HUMI sedang menyinkronkan katalog, notifikasi muncul di sini begitu jawaban ke customer sudah pakai data baru (±1 menit).` } }];"
