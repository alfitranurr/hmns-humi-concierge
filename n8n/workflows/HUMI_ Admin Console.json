    {
      "parameters": {
        "jsCode": "// Build the announcement for !broadcast <text>\nconst text = ($json.args || []).join(' ');\n\nif (!text) {\n  return [{ json: { ...$json, broadcast_text: '⚠️ Format salah. Gunakan: !broadcast <teks pengumuman>' } }];\n}\n\nreturn [{ json: { ...$json, broadcast_text: `📢 **Pengumuman dari HMNS!**\\n\\n${text}` } }];"
      },
      "id": "709c7290-4a25-40aa-9a1e-d2cb2a8edb35",
      "name": "Build Broadcast Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        880
      ]
    },
    {
      "parameters": {
        "jsCode": "// Basic health report. n8n is up if this workflow runs; Qdrant and Gemini quota checks need extra HTTP nodes.\nconst now = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });\nconst status_text = [\n  '🩺 **Status Sistem HUMI**',\n  '',\n  '✅ n8n: Online',\n  '✅ Workflow Admin Console: Aktif',\n  `🕐 Dicek pada: ${now} WIB`,\n].join('\\n');\n\nreturn [{ json: { ...$json, status_text } }];"
      },
      "id": "276d64f9-bd0f-4c62-846d-1ea2590f0a4c",
      "name": "Build Status Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        1040
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH bounds AS (\n    SELECT (date_trunc('day', now() AT TIME ZONE 'Asia/Jakarta') AT TIME ZONE 'Asia/Jakarta') AS start_of_day\n)\nSELECT\n    COUNT(*) FILTER (WHERE message->>'type' = 'human' AND created_at >= bounds.start_of_day) AS chats_today,\n    COUNT(DISTINCT session_id) FILTER (WHERE created_at >= bounds.start_of_day) AS users_today,\n    COUNT(*) FILTER (WHERE message->>'type' = 'human' AND created_at >= now() - interval '7 days') AS chats_7_days,\n    COUNT(DISTINCT session_id) FILTER (WHERE created_at >= now() - interval '7 days') AS users_7_days,\n    COUNT(*) FILTER (WHERE message->>'type' = 'human') AS chats_total,\n    COUNT(DISTINCT session_id) AS users_total\nFROM humi_chat_memory, bounds;",
        "options": {}
      },
      "id": "c6a9350c-d9a8-42e4-8037-34d985367f34",
      "name": "Query Chat Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1264,
        1200
      ],
      "credentials": {
        "postgres": {
          "id": "qunLdRuScbJcnKnz",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Format chat statistics (a \"pesan\" is a customer message, not a HUMI reply)\nconst r = $json;\nconst n = (v) => Number(v || 0).toLocaleString('id-ID');\nconst log_text = [\n  '📊 **Log Chat HUMI**',\n  '',\n  `**Hari ini:** ${n(r.chats_today)} pesan dari ${n(r.users_today)} user`,\n  `**7 hari terakhir:** ${n(r.chats_7_days)} pesan dari ${n(r.users_7_days)} user`,\n  `**Total:** ${n(r.chats_total)} pesan dari ${n(r.users_total)} user`,\n].join('\\n');\n\nreturn [{ json: { ...r, log_text } }];"
      },
      "id": "fe350fd6-d853-4f34-815f-a39dc2bbc3fc",
      "name": "Build Log Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        1200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fallback: bad command format or unknown command\nif ($json.error_text) {\n  return [{ json: { ...$json, fallback_text: $json.error_text } }];\n}\nreturn [{ json: { ...$json, fallback_text: `❓ Command \\`${$json.command || '(kosong)'}\\` tidak dikenali. Ketik \\`!help\\` untuk daftar command.` } }];"
      },
