      "parameters": {
        "jsCode": "const row = $json;\nconst sku = row.SKU || row.sku;\nconst nama = row.nama || row.Nama || sku;\nconst harga = row.Harga || row.harga;\n\nif (!sku) {\n  return [{ json: { ...row, harga_reply: `⚠️ SKU tidak ditemukan. Pastikan format: \\`!harga HMNS-PRF-001 350000\\`` } }];\n}\n\nreturn [{ json: { ...row, harga_reply: `✅ Harga **${nama}** (${sku}) berhasil diupdate jadi **Rp${Number(harga).toLocaleString('id-ID')}**.` } }];"
