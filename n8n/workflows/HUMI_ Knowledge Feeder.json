    {
      "parameters": {
        "jsCode": "// Compare the sheet with the last sync. If nothing changed, stop here so no Gemini quota is used.\nconst perfume = $('Read Sheet - Perfume').all().map((i) => i.json).filter((r) => r.SKU && r.Name);\nconst home = $('Read Sheet - Home of Humans').all().map((i) => i.json).filter((r) => r.SKU && r.Name);\n\n// Empty or unreadable sheet: leave Qdrant and the products table untouched.\nif (perfume.length === 0 || home.length === 0) {\n  throw new Error(`Sheet is empty or unreadable (perfume ${perfume.length}, home ${home.length}). Sync cancelled.`);\n}\n\nconst snapshot = JSON.stringify({ perfume, home });\nlet hash = 5381;\nfor (let i = 0; i < snapshot.length; i++) {\n  hash = ((hash << 5) + hash + snapshot.charCodeAt(i)) | 0;\n}\nconst version = `${(hash >>> 0).toString(16)}-${snapshot.length}`;\n\nconst state = $getWorkflowStaticData('global');\n// Any run started from the editor (whichever trigger) counts as a manual, forced sync.\nconst manual = $execution.mode === 'test' || $('Manual Trigger (Force Sync)').isExecuted;\nif (!manual && state.catalogVersion === version) {\n  return [];\n}\n\n// The reason is shown to admins, so it stays in Indonesian.\nlet reason = 'sheet berubah';\nif (manual) reason = 'dijalankan manual';\nelse if ($('Called by Admin Console').isExecuted) reason = 'update dari command admin';\nelse if (!state.catalogVersion) reason = 'sinkron pertama';\n\n// Every vector written by this run is tagged with synced_at; cleanup later removes anything older,\n// so the newest run always survives and repeated or overlapping runs never leave duplicates.\nreturn [{ json: { version, synced_at: Date.now(), reason, perfume_count: perfume.length, home_count: home.length } }];"
      },
      "id": "fca04231-790c-44ee-8546-18c9f5fb5822",
      "name": "Detect Catalog Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        896
      ]
    },
    {
      "parameters": {
        "jsCode": "// Perfume tab rows -> products table (used by admin commands)\nreturn $('Read Sheet - Perfume').all()\n  .map((i) => i.json)\n  .filter((r) => r.SKU && r.Name)\n  .map((r) => ({\n    json: {\n      sku: String(r.SKU).trim(),\n      name: String(r.Name).trim(),\n      price: Number(String(r.Price).replace(/[^0-9]/g, '')) || null,\n      web_stock: String(r.Web_Stock ?? '').trim(),\n    },\n  }));"
      },
      "id": "97ad2d77-5c11-4a43-a64b-da39ca73cdff",
      "name": "Prepare Product Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2784,
        896
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO products (sku, name, price, web_stock, updated_at)\nVALUES ($1, $2, $3, $4, now())\nON CONFLICT (sku) DO UPDATE\nSET name = EXCLUDED.name, price = EXCLUDED.price, web_stock = EXCLUDED.web_stock, updated_at = now()\nWHERE (products.name, products.price, products.web_stock)\n      IS DISTINCT FROM (EXCLUDED.name, EXCLUDED.price, EXCLUDED.web_stock);",
        "options": {
          "queryReplacement": "={{ [$json.sku, $json.name, $json.price, $json.web_stock] }}"
        }
      },
      "id": "61a9a407-1efc-4698-ad0f-efba671511b0",
      "name": "Upsert Products Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3008,
        896
      ],
      "credentials": {
        "postgres": {
          "id": "postgresAccount",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
