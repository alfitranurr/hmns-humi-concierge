    {
      "parameters": {
        "jsCode": "// Gabungkan semua kolom produk Parfum jadi 1 blok teks yang siap di-embed\nconst items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const d = item.json;\n\n  // Lewati baris kosong/tanpa nama\n  if (!d.Nama) continue;\n\n  const teks = `Produk: ${d.Nama || ''}\nTipe: ${d.Tipe || ''}\nUkuran: ${d.Ukuran || ''}\nFamily Aroma: ${d.Family_Aroma || ''}\nMind Notes: ${d.Mind_Notes || ''}\nHeart Notes: ${d.Heart_Notes || ''}\nSoul Notes: ${d.Soul_Notes || ''}\nDeskripsi: ${d.Deskripsi || ''}\nSillage: ${d.Sillage || ''}\nProjection: ${d.Projection || ''}\nLongevity: ${d.Longevity || ''}\nHarga: Rp${d.Harga || ''}\nStok: ${d.Stok_Web || ''}\nLink Web: ${d.Link_Web || ''}\nLink Marketplace: ${d.Link_Marketplace || ''}`.trim();\n\n  output.push({\n    json: {\n      sku: d.SKU || '',\n      nama: d.Nama || '',\n      harga: d.Harga || '',\n      link_web: d.Link_Web || '',\n      text: teks,\n      collection: 'hmns_parfum'\n    }\n  });\n}\n\nreturn output;"
      },
