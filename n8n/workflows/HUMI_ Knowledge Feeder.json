      "parameters": {
        "jsCode": "// Turn each catalog row into one text block for embedding, tagged with the catalog version and sync time.\nconst { version, synced_at } = $('Detect Catalog Changes').first().json;\nconst output = [];\n\nfor (const item of $('Read Sheet - Perfume').all()) {\n  const d = item.json;\n\n  // Skip empty rows or rows without a name\n  if (!d.Name) continue;\n\n  const text = `Product: ${d.Name || ''}\nType: ${d.Type || ''}\nSize: ${d.Size || ''}\nFragrance Family: ${d.Fragrance_Family || ''}\nMind Notes: ${d.Mind_Notes || ''}\nHeart Notes: ${d.Heart_Notes || ''}\nSoul Notes: ${d.Soul_Notes || ''}\nDescription: ${d.Description || ''}\nSillage: ${d.Sillage || ''}\nProjection: ${d.Projection || ''}\nLongevity: ${d.Longevity || ''}\nPrice: Rp${d.Price || ''}\nStock: ${d.Web_Stock || ''}\nWeb URL: ${d.Web_URL || ''}`.trim();\n\n  output.push({\n    json: {\n      sku: d.SKU || '',\n      name: d.Name || '',\n      price: d.Price || '',\n      web_url: d.Web_URL || '',\n      text,\n      version,\n      synced_at,\n      collection: 'hmns_parfum'\n    }\n  });\n}\n\nreturn output;"
      },
