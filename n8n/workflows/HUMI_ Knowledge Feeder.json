    {
      "parameters": {
        "jsCode": "// Remember which catalog version is in Qdrant, then build the report for admins (in Indonesian)\nconst info = $('Detect Catalog Changes').first().json;\nconst state = $getWorkflowStaticData('global');\nstate.catalogVersion = info.version;\nstate.lastSyncAt = new Date().toISOString();\n\nconst time = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });\nconst report = [\n  `🔄 **Katalog HUMI tersinkron** (${info.reason})`,\n  `${info.perfume_count} parfum + ${info.home_count} Home of Humans sudah dipakai HUMI untuk jawab customer.`,\n  `🕐 ${time} WIB`,\n].join('\\n');\n\nreturn [{ json: { ...info, report } }];"
      },
